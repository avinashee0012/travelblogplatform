{
  "info": {
    "name": "Travel Blog Platform API (OpenAPI-based)",
    "description": "Manual testing collection generated from api-docs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "blogId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "slug", "value": "" },
    { "key": "username", "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john\",\n  \"email\": \"john@email.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@email.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Public Blogs",
      "item": [
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/blogs?page=0&size=10&sortBy=createdAt&sortDirection=desc"
          }
        },
        {
          "name": "Get Blog by Slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/blogs/{{slug}}"
          }
        },
        {
          "name": "Search Blogs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/blogs/search?keyword=goa&page=0&size=10"
          }
        },
        {
          "name": "Get Blog Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/blogs/{{blogId}}/comments"
          }
        }
      ]
    },

    {
      "name": "Blogs (AUTHOR)",
      "item": [
        {
          "name": "Create Blog",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/blogs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Exploring Goa Beaches\",\n  \"content\": \"This blog describes beautiful beaches of Goa with travel tips and experiences.\",\n  \"imageUrl\": \"\",\n  \"videoUrl\": \"\",\n  \"categoryName\": \"Beach\"\n}"
            }
          }
        },
        {
          "name": "Update Blog",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/blogs/{{blogId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Goa Beaches\",\n  \"content\": \"Updated content with better insights.\",\n  \"categoryName\": \"Beach\"\n}"
            }
          }
        },
        {
          "name": "Publish Blog",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/blogs/{{blogId}}/publish"
          }
        },
        {
          "name": "Delete Blog",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/blogs/{{blogId}}"
          }
        }
      ]
    },

    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/blogs/{{blogId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Very helpful travel blog!\"\n}"
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/blogs/comments/{{commentId}}"
          }
        }
      ]
    },

    {
      "name": "Admin",
      "item": [
        {
          "name": "Make User AUTHOR",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/admins/users/{{userId}}/make-author"
          }
        },
        {
          "name": "Make User ADMIN",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/admins/users/{{userId}}/make-admin"
          }
        },
        {
          "name": "Mark Blog NEED_REVIEW",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/admins/blogs/{{blogId}}/status/need-review"
          }
        },
        {
          "name": "Remove Blog",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/admins/blogs/{{blogId}}/status/removed"
          }
        },
        {
          "name": "Hide Comment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/admins/comments/{{commentId}}/hide"
          }
        }
      ]
    },

    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Author Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{username}}"
          }
        }
      ]
    }

  ]
}
